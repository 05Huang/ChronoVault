{
  "info": {
    "name": "ChronoVault API v1",
    "description": "Complete API test collection for ChronoVault backend.\n\nAll responses follow the ApiResponse format:\n{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {},\n  \"timestamp\": \"2026-01-01T00:00:00\"\n}\n\nPaginated responses use PageResponse:\n{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"content\": [],\n    \"page\": 0,\n    \"size\": 20,\n    \"totalElements\": 100,\n    \"totalPages\": 5\n  },\n  \"timestamp\": \"...\"\n}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "serverId", "value": "" },
    { "key": "snapshotId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has ApiResponse structure', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('code', 200);",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "  pm.expect(body.data).to.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Test User\", \"email\": \"test@example.com\", \"password\": \"TestPass123!\"}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns JWT token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('token');",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"password\": \"TestPass123!\"}"
            }
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has ApiResponse structure', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('code', 200);",
                  "  pm.expect(body.data).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns new token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\": \"\"}" }
          }
        }
      ]
    },
