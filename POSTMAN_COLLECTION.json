          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/servers/{{serverId}}", "host": ["{{baseUrl}}"], "path": ["servers", "{{serverId}}"] }
          }
        },
        {
          "name": "Test SSH Connection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.code));",
                  "pm.test('Response uses ApiResponse format', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('code');",
                  "  pm.expect(body).to.have.property('message');",
