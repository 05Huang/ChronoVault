# ============================================================
# ChronoVault 环境变量配置
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# ============================================================

# ==================== 数据库 ====================
POSTGRES_DB=chronovault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== JWT ====================
# 至少 256 位 (32 字节) 的随机字符串
JWT_SECRET=change-this-to-a-random-256-bit-secret-key
JWT_EXPIRATION=86400000

# ==================== ChronoVault 核心 ====================
# AES-256-GCM 加密主密钥，用于加密存储 SSH 凭据
# 生成方式: openssl rand -hex 32
CHRONOVAULT_MASTER_KEY=change-this-with-openssl-rand-hex-32

# Restic 加密密码，用于加密备份数据
# 生成方式: openssl rand -hex 32
CHRONOVAULT_RESTIC_PASSWORD=change-this-with-openssl-rand-hex-32

# Spring 激活的配置文件 (dev/test/prod)
SPRING_PROFILES_ACTIVE=dev

# ==================== AI 配置 (小米 MiMo-V2.5-Pro) ====================
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=your-mimo-api-key
MIMO_MODEL=mimo-v2.5-pro

# ==================== 前端 ====================
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws/events

# ==================== 生产环境专用 ====================
# 以下变量仅在 SPRING_PROFILES_ACTIVE=prod 时需要
# POSTGRES_HOST=your-db-host
# POSTGRES_PORT=5432
# REDIS_PASSWORD=your-redis-password
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# SSH_KNOWN_HOSTS_FILE=/etc/chronovault/known_hosts
# MIMO_ENABLED=false
